<% @loaded = 'false' %>
<% @reducedHash.each do |uniqueName, monsterData| %>

<div data-role="page" class="jqm-demos jqm-home" id="<%= uniqueName %>" data-url="<%= uniqueName %>">

<%= erb :'sections/header' %>
<%= erb :'sections/nav-panel' %>
<%= erb :'sections/search-panel', locals: {loaded: @loaded} %>
<% @loaded = 'true' %>

         <div role="main" class="ui-content">
            <h3 class="ui-bar ui-bar-a ui-corner-all"><%= monsterData['name'] %></h3>
            <div class="ui-body ui-body-a ui-corner-all">
               <p>
                  <% if monsterData.include?('d') %>
                  <b>Description:</b> <%= monsterData['d'] %><br>
                  <% end %>
                  <% if monsterData.include?('g') %>
                  <b>Garb:</b> <%= monsterData['g'] %><br>
                  <% end %>
                  <% if monsterData.include?('ar') %>
                  <b>Armor:</b> <%= monsterData['ar'] %><br>
                  <% end %>
                  <% if monsterData.include?('s') %>
                  <b>Shields:</b> <%= monsterData['s'] %><br>
                  <% end %>
                  <% if monsterData.include?('w') %>
                  <b>Weapons:</b> <%= monsterData['w'] %><br>
                  <% end %>
                  <% if monsterData.include?('a') %>
                  <b>Abilities:</b><br><%= monsterData['a'] %>
                  <% end %>
               </p>
            </div>
         </div>
         <!-- /content -->

</div><!-- /page -->
<% end %>


