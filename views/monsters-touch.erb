<% @loaded = 'false' %>
<%  monstersTouch = @allmonsters.reject {|k,v|
          if (v['t'].casecmp('Enchantment')) != 0 && v.has_key?('r') && (v['r'].include? "Touch")
               false
          elsif (v['t'].casecmp('Enchantment')) != 0 && v.has_key?('r') && (v['r'].include? "Other")
               false
          else
               true
          end

     }%>

<div data-role="page" class="jqm-demos jqm-home" id="monsters-touch">

<%= erb :'sections/updated' %>
<%= erb :'sections/header' %>
<%= erb :'sections/nav-panel' %>
<%= erb :'sections/search-panel', locals: {loaded: @loaded} %>
<% @loaded = 'true' %>

         <div role="main" class="ui-content">
            <ul data-role="listview" data-filter="true" data-autodividers="true" data-filter-placeholder="Search monsters (Touch)" data-inset="true" data-icon="false">

<% monstersTouch.each {|key, value| %>

               <li><a href=<%="/monsters/#{key[0]}##{key}"%> data-ajax="false"><%="#{value['name']}"%></a></li>
<% } %>
            </ul>
         </div>
         <!-- /content -->

</div><!-- /page -->
